---
import { ClientRouter } from 'astro:transitions';

const { title = 'Britt Joosten — Portfolio' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Portfolio of product designer Britt Joosten." />

    <link
      rel="preload"
      href="/fonts/Vipnagorgialla%20Rg.otf"
      as="font"
      type="font/otf"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/Vipnagorgialla%20Bd.otf"
      as="font"
      type="font/otf"
      crossorigin
    />

    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <div class="home-portrait-backdrop" transition:persist="home-portrait-backdrop" aria-hidden="true">
      <img
        class="portrait-image"
        src="/images/optimized/home-portrait-1920.webp"
        srcset="/images/optimized/home-portrait-1280.webp 1280w, /images/optimized/home-portrait-1920.webp 1920w, /images/optimized/home-portrait-2800.webp 2800w, /images/optimized/home-portrait.webp 3948w"
        sizes="calc(100vw - clamp(12rem, 22vw, 27.5rem))"
        alt=""
        loading="lazy"
        decoding="async"
        fetchpriority="high"
      />
    </div>
    <slot />
  </body>
</html>