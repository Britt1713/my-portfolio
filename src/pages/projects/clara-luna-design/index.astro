---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import '../../../styles/global.css';
---

<SiteLayout title="Clara Luna Design — Britt Joosten">
  <main class="clara-page">
    <a class="clara-back" href="/my-portfolio/projects/">← Projects &amp; Works</a>

    <article class="clara-content">
      <header class="clara-header">
        <h1>Clara Luna Design</h1>
      </header>

      <section class="clara-intro" aria-label="Project overview">
        <img
          class="clara-hero-image"
          src="/my-portfolio/images/IMG_20220211_125123.jpg"
          alt="A collection of custom illustrations created for Clara Luna Design"
          fetchpriority="high"
        />
        <dl class="clara-metadata">
          <div>
            <dt>Timeline</dt>
            <dd>Nov. 2020 – Jan. 2026</dd>
          </div>
          <div>
            <dt>Project type</dt>
            <dd>Co-ownership</dd>
          </div>
          <div>
            <dt>Tools &amp; software</dt>
            <dd>Adobe Illustrator</dd>
          </div>
          <div>
            <dt>Key skills</dt>
            <dd>Graphic Design / Illustration / Branding / Print Production / Customer Relations</dd>
          </div>
        </dl>
      </section>

      <section class="clara-story" aria-label="About the project">
        <div class="clara-copy">
          <div>
            <p>
              In November 2020, I co-founded Clara Luna Design, a graphic design business offering
              personalised digital illustrations, branding, and printed designs. We initially
              created custom drawings based on photographs provided by customers, later expanding
              into illustrations of buildings and a collection of architectural posters featuring
              my hometown. We sold both digital files and physical prints in various sizes,
              receiving approximately 175 orders in our first year, including larger orders from
              retail stores for resale. The architectural collection continues to generate
              occasional sales today.
            </p>
            <p>
              As the business developed, I explored visual styles, refined designs through client
              feedback, and prepared artwork for both digital and print formats.
            </p>
          </div>
          <div>
            <p>
              Alongside the creative work, I managed client communication, social media, pricing,
              orders, and fulfilment while running the business alongside my studies.
            </p>
            <p>
              This experience taught me the value of customisation and responding to customer
              preferences, while showing me how a creative concept can evolve into a sellable
              product. The continued sales of my architectural illustrations have also reinforced
              the value of creating designs with lasting appeal, combining visual creativity with
              commercial awareness.
            </p>
          </div>
        </div>

        <img
          class="clara-story-image"
          src="/my-portfolio/images/Clara Luna 1.png"
          alt="Grid of personalised family illustrations, architectural prints and product styling"
          loading="lazy"
        />
      </section>
    </article>

    <div class="clara-divider" aria-hidden="true"></div>

    <section class="clara-gallery" aria-label="Clara Luna Design work examples">
      <img
        src="/my-portfolio/images/Clara Luna 2.png"
        alt="Architectural illustration print shown in front of the building it depicts"
        loading="lazy"
      />
      <img
        src="/my-portfolio/images/Clara Luna 3.png"
        alt="Personalised family illustration"
        loading="lazy"
      />
      <img
        src="/my-portfolio/images/Clara Luna 4.png"
        alt="Clara Luna Design branded tote bag"
        loading="lazy"
      />
    </section>
  </main>
</SiteLayout>

<style is:global>
  html:has(.clara-page),
  body:has(.clara-page) {
    height: auto;
    min-height: 100%;
    overflow-x: hidden;
    overflow-y: auto;
  }

  .clara-page {
    --clara-aqua: #a4e1dc;
    --clara-ink: #172332;
    min-height: 100svh;
    padding: 1px 0 4rem;
    background: #fff;
    color: var(--clara-ink);
    font-family: 'Avenir', Arial, sans-serif;
  }

  .clara-back {
    position: absolute;
    top: 2rem;
    left: 2rem;
    z-index: 2;
    color: var(--clara-ink);
    font-family: 'Vipnagorgialla', sans-serif;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .clara-back:hover,
  .clara-back:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .clara-content {
    width: min(64%, 980px);
    margin: 0 auto;
    padding-top: clamp(6.5rem, 12vh, 9.5rem);
  }

  .clara-header h1 {
    margin: 0 0 clamp(1.1rem, 2vw, 1.75rem);
    color: var(--clara-aqua);
    font-family: 'Vipnagorgialla', sans-serif;
    font-size: clamp(1.75rem, 2.75vw, 2.85rem);
    font-weight: 400;
    line-height: 1.05;
  }

  .clara-intro {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(16rem, 1fr);
    align-items: start;
    gap: clamp(2.5rem, 3vw, 5rem);
  }

  .clara-hero-image {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: center;
    transform: rotate(-90deg);
  }

  .clara-metadata {
    display: grid;
    gap: clamp(0.85rem, 1.3vw, 1.25rem);
    margin: 0;
    padding-top: 0.1rem;
  }

  .clara-metadata dt {
    margin-bottom: 0.35rem;
    font-size: clamp(0.72rem, 0.78vw, 0.85rem);
    font-weight: 700;
    text-transform: uppercase;
  }

  .clara-metadata dd {
    margin: 0;
    font-size: clamp(0.75rem, 0.8vw, 0.88rem);
    line-height: 1.45;
  }

  .clara-story {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(14rem, 0.85fr);
    align-items: start;
    gap: clamp(1.75rem, 3.2vw, 3.5rem);
    margin-top: clamp(2.5rem, 5vh, 4rem);
    padding-bottom: clamp(2.5rem, 5vh, 4rem);
  }

  .clara-copy {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.25rem, 1.8vw, 1.75rem);
    font-size: clamp(0.76rem, 0.8vw, 0.88rem);
    line-height: 1.4;
    text-align: justify;
  }

  .clara-copy p {
    margin: 0 0 1.1rem;
  }

  .clara-story-image {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .clara-divider {
    width: 100%;
    height: clamp(0.65rem, 0.9vw, 0.95rem);
    background: var(--clara-aqua);
  }

  .clara-gallery {
    display: grid;
    width: min(64%, 980px);
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: stretch;
    gap: clamp(0.85rem, 1.4vw, 1.35rem);
    margin: 0 auto;
    padding: clamp(3rem, 5vw, 4.5rem) 0;
  }

  .clara-gallery img {
    display: block;
    width: 100%;
    aspect-ratio: 0.78;
    object-fit: cover;
  }

  @media (max-width: 900px) {
    .clara-content {
      width: min(86%, 760px);
      padding-top: 6rem;
    }

    .clara-header h1 {
      font-size: clamp(2.8rem, 6.5vw, 4.8rem);
    }

    .clara-intro {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
      gap: 1.5rem;
    }

    .clara-story {
      grid-template-columns: minmax(0, 1fr) minmax(14rem, 0.75fr);
      gap: 1.5rem;
    }

    .clara-copy {
      grid-template-columns: 1fr;
      gap: 0;
      font-size: 0.9rem;
    }

    .clara-gallery {
      width: 86%;
      gap: 0.8rem;
    }
  }

  @media (max-width: 600px) {
    .clara-page {
      padding-bottom: 2rem;
    }

    .clara-back {
      top: 1.25rem;
      left: 1.15rem;
      font-size: 0.8rem;
    }

    .clara-content {
      width: calc(100% - 2.25rem);
      padding-top: 4.5rem;
    }

    .clara-header h1 {
      margin-bottom: 1rem;
      font-size: clamp(2.5rem, 11vw, 3.7rem);
    }

    .clara-intro,
    .clara-story {
      grid-template-columns: 1fr;
    }

    .clara-intro {
      gap: 1.5rem;
    }

    .clara-metadata {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }

    .clara-metadata dt {
      margin-bottom: 0.35rem;
      font-size: 0.72rem;
    }

    .clara-metadata dd {
      font-size: 0.78rem;
    }

    .clara-story {
      gap: 1rem;
      margin-top: 2rem;
      padding-bottom: 2.5rem;
    }

    .clara-copy {
      grid-template-columns: 1fr;
      font-size: 0.9rem;
    }

    .clara-story-image {
      width: min(100%, 28rem);
      margin: 0 auto;
    }

    .clara-gallery {
      width: calc(100% - 2.25rem);
      grid-template-columns: 1fr;
      gap: 1rem;
      padding: 2.5rem 0;
    }

    .clara-gallery img {
      width: min(100%, 28rem);
      aspect-ratio: 0.85;
      margin: 0 auto;
    }
  }
</style>
