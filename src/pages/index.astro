---
import SiteLayout from '../layouts/SiteLayout.astro';
import HomeMenu from '../components/HomeMenu.astro';
import '../styles/global.css';
---

<SiteLayout>
  <main class="home-page">
    <HomeMenu />

    <section class="hero-collage" aria-labelledby="hero-title">
      <div class="portrait-panel">
        <img
          class="portrait-image"
          src="/my-portfolio/images/breder_bw2.png"
          alt="Britt Joosten"
        />
      </div>

      <span class="portfolio-wordmark">Portfolio</span>
      <span class="designer-name">Britt Joosten</span>

      <div class="hero-art" aria-hidden="true">
        <img class="hero-star" src="/my-portfolio/images/Star.png" alt="" />
        <img class="hero-tape" src="/my-portfolio/images/9ee222268fd1d3fd6f07e9e40d8056c9.png" alt="" />
        <img class="hero-title" src="/my-portfolio/images/Title.png" alt="" />
      </div>

    </section>
  </main>
</SiteLayout>
