---
import SiteLayout from '../layouts/SiteLayout.astro';
import HomeMenu from '../components/HomeMenu.astro';
import '../styles/global.css';
---

<SiteLayout>
  <main class="home-page">
    <HomeMenu />

    <section class="hero-collage" aria-labelledby="hero-title">
      <div class="portrait-panel">
        <img
          class="portrait-image"
          src="/images/optimized/home-portrait-1920.webp"
          srcset="/images/optimized/home-portrait-1280.webp 1280w, /images/optimized/home-portrait-1920.webp 1920w, /images/optimized/home-portrait-2800.webp 2800w, /images/optimized/home-portrait.webp 3948w"
          sizes="calc(100vw - clamp(12rem, 22vw, 27.5rem))"
          alt="Britt Joosten"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </div>

      <span class="portfolio-wordmark">Portfolio</span>
      <span class="designer-name">Britt Joosten</span>

      <div class="hero-art" aria-hidden="true">
        <img class="hero-star" src="/images/Star.png" alt="" />
        <img class="hero-tape" src="/images/9ee222268fd1d3fd6f07e9e40d8056c9.png" alt="" />
        <img class="hero-title" src="/images/Title.png" alt="" />
      </div>

    </section>
  </main>
</SiteLayout>
