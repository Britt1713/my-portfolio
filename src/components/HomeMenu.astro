---
const items = [
  { label: 'Projects & Works', href: '/projects/', image: '/images/optimized/navigation-projects.webp' },
  { label: 'About me', href: '/about/', image: '/images/optimized/navigation-about.webp' },
  { label: 'Contact', href: '/contact/', image: '/images/optimized/navigation-contact.webp' },
];
---

<nav class="home-menu" aria-label="Main navigation">
  <div class="menu-items">
    {items.map((item) => (
      <a class="menu-item" href={item.href}>
        <span class="menu-image">
          <img class="menu-photo" src={item.image} alt="" loading="eager" decoding="async" fetchpriority="high" />
        </span>
        <span class="menu-title">{item.label}</span>
      </a>
    ))}
  </div>
</nav>
